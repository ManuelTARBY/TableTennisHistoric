@page
@model TableTennisHistoric.Pages.Players.AffiliateModel
@{
    ViewData["Title"] = "Créer une affiliation";
}

<h1 class="mb-4 text-center">Créer une affiliation</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="border rounded p-4 shadow-sm bg-light" style="max-width: 500px; margin: auto;">
    <form method="post" asp-page-handler="Create">
        <div class="mb-3">
            <label class="form-label fw-bold">Joueur</label>
            <div class="d-flex gap-2 align-items-center">
                <select asp-for="SelectedPlayerId"
                        asp-items="Model.Players"
                        class="form-select"
                        id="playerSelect">
                    <option value="">-- Sélectionnez un joueur --</option>
                </select>
                <a id="managePlayerSeasonBtn"
                   href="#"
                   class="btn btn-outline-secondary d-none"
                   title="Gérer les affiliations">
                    <i class="bi bi-pencil-square"></i>
                </a>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Catégorie</label>
            <select asp-for="SelectedCategory"
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<Models.PlayerSeason.PlayerCategory>()">
                <option value="">-- Sélectionnez une catégorie --</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Club</label>
            <select asp-for="SelectedClubId" asp-items="Model.Clubs" class="form-select">
                <option value="">-- Sélectionnez un club --</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Saison</label>
            <select asp-for="SelectedSeasonId" asp-items="Model.Seasons" class="form-select">
                <option value="">-- Sélectionnez une saison --</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Points début de saison</label>
            <input asp-for="StartPoints" type="number" step="1" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Points milieu de saison</label>
            <input asp-for="MiddlePoints" type="number" step="1" class="form-control" />
        </div>
        <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-plus-circle"></i> Créer l'affiliation
        </button>
    </form>
</div>

@section Scripts {
    <script>
        const playerSelect = document.getElementById('playerSelect');
        const manageBtn = document.getElementById('managePlayerSeasonBtn');
        const baseUrl = '/Players/ManagePlayerSeason/';
        const returnUrl = encodeURIComponent('/Players/Affiliate');

        function updateBtn() {
            const playerId = playerSelect.value;
            if (playerId && playerId !== '') {
                const returnUrl = encodeURIComponent('/Players/Affiliate?SelectedPlayerId=' + playerId);
                manageBtn.href = `${baseUrl}${playerId}?returnUrl=${returnUrl}`;
                manageBtn.classList.remove('d-none');
            } else {
                manageBtn.classList.add('d-none');
            }
        }

        // Au chargement si un joueur est déjà présélectionné
        updateBtn();

        // À chaque changement de sélection
        playerSelect.addEventListener('change', updateBtn);
    </script>
}