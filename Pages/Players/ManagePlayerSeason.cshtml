@page "{playerId:int}"
@model TableTennisHistoric.Pages.Players.ManagePlayerSeasonModel
@{
    ViewData["Title"] = "Gestion des affiliations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Affiliations @Model.DeOuD@Model.PlayerFullName</h1>
    <a asp-page="/Players/Create"
       asp-route-SelectedPlayerId="@Model.PlayerId"
       class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Ajouter une affiliation
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

@if (!Model.PlayerSeasons.Any())
{
    <div class="alert alert-info">Aucune affiliation trouvée pour @Model.PlayerFullName.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Saison</th>
                <th>Club</th>
                <th>Points début</th>
                <th>Points milieu</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ps in Model.PlayerSeasons)
            {
                <form id="update-form-@ps.Id" method="post" asp-page-handler="Update">
                    <input type="hidden" name="EditForm.Id" value="@ps.Id" />
                    <input type="hidden" name="EditForm.PlayerId" value="@ps.PlayerId" />
                    <input type="hidden" name="EditForm.SeasonId" value="@ps.SeasonId" />
                    <input type="hidden" name="EditForm.ClubId" value="@ps.ClubId" />
                    <input type="hidden" name="PlayerId" value="@Model.PlayerId" />
                </form>

                <tr>
                    <td>@ps.SeasonName</td>
                    <td>@ps.ClubName</td>
                    <td>
                        <input type="number"
                               name="EditForm.Points_start"
                               value="@Math.Round(ps.Points_start ?? 0, 0)"
                               form="update-form-@ps.Id"
                               class="form-control form-control-sm text-center"
                               style="width: 100px;" step="1" />
                    </td>
                    <td>
                        <input type="number"
                               name="EditForm.Points_middle"
                               value="@Math.Round(ps.Points_middle ?? 0, 0)"
                               form="update-form-@ps.Id"
                               class="form-control form-control-sm text-center"
                               style="width: 100px;" step="1" />
                    </td>
                    <td class="text-center">
                        <div class="btn-group">
                            <button type="submit"
                                    form="update-form-@ps.Id"
                                    class="btn btn-sm btn-outline-warning"
                                    title="Enregistrer">
                                <i class="bi bi-save"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    title="Supprimer"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-bs-id="@ps.Id"
                                    data-bs-season="@ps.SeasonName.ToLower()"
                                    data-bs-player="@Model.PlayerFullName">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Modale de suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Êtes-vous sûr de vouloir supprimer la
                    <strong id="modalSeasonName"></strong>
                    <span id="modalDeOuD"></span><strong id="modalPlayerName"></strong> ?
                </p>
                <p class="text-muted small">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" id="modalPlayerSeasonId" />
                    <input type="hidden" name="PlayerId" value="@Model.PlayerId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Supprimer définitivement</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-page="/OpponentsHistoric"
       asp-route-SelectedOpponentId="@Model.PlayerId"
       class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

@section Scripts {
    <script>

        function getDeOuD(name) {
            if (!name) return "de ";
            const voyelles = "aeiouàâäéèêëîïôöùûüæœAEIOUÀÂÄÉÈÊËÎÏÔÖÙÛÜÆŒ";
            return voyelles.includes(name[0]) ? "d'" : "de ";
        }

        deleteModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-bs-id');
            const season = button.getAttribute('data-bs-season');
            const player = button.getAttribute('data-bs-player');

            document.getElementById('modalPlayerSeasonId').value = id;
            document.getElementById('modalSeasonName').textContent = season;
            document.getElementById('modalPlayerName').textContent = player;

            // Met à jour le "de/d'" dans la modale
            document.getElementById('modalDeOuD').textContent = getDeOuD(player);
        });

        document.addEventListener('DOMContentLoaded', () => {
            const deleteModal = document.getElementById('deleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', event => {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-bs-id');
                    const season = button.getAttribute('data-bs-season');
                    const player = button.getAttribute('data-bs-player');

                    document.getElementById('modalPlayerSeasonId').value = id;
                    document.getElementById('modalSeasonName').textContent = season;
                    document.getElementById('modalPlayerName').textContent = player;
                });
            }
        });
    </script>
}