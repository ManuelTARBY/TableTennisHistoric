@page
@model TableTennisHistoric.Pages.Players.CreateModel
@{
    ViewData["Title"] = "Gestion des joueurs";
}

<h1 class="mb-4 text-center">Gestion des joueurs</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<!-- Formulaire de création -->
<div class="border rounded p-4 shadow-sm bg-light mb-4">
    <h4 class="mb-3 text-primary">Créer un joueur</h4>
    <form method="post" asp-page-handler="Create">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Prénom</label>
                <input asp-for="CreateForm.First_name" class="form-control" maxlength="50" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Nom</label>
                <input asp-for="CreateForm.Last_name" class="form-control"
                       style="text-transform: uppercase;" maxlength="50" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Numéro de licence</label>
                <input asp-for="CreateForm.License_number" class="form-control" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-circle"></i> Créer
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Tableau de modification -->
<table class="table table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Licence</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Players)
        {
            <form id="update-form-@p.Id" method="post" asp-page-handler="Update">
                <input type="hidden" name="EditForm.Id" value="@p.Id" />
            </form>

            <tr>
                <td>
                    <input type="text"
                           name="EditForm.First_name"
                           value="@p.First_name"
                           form="update-form-@p.Id"
                           class="form-control form-control-sm"
                           maxlength="50" />
                </td>
                <td>
                    <input type="text"
                           name="EditForm.Last_name"
                           value="@p.Last_name"
                           form="update-form-@p.Id"
                           class="form-control form-control-sm"
                           style="text-transform: uppercase;"
                           maxlength="50" />
                </td>
                <td>
                    <input type="text"
                           name="EditForm.License_number"
                           value="@p.License_number"
                           form="update-form-@p.Id"
                           class="form-control form-control-sm" />
                </td>
                <td class="text-center">
                    <button type="submit"
                            form="update-form-@p.Id"
                            class="btn btn-sm btn-outline-warning"
                            title="Enregistrer">
                        <i class="bi bi-save"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>