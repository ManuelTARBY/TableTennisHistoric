                },
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return 'Victoires : ' + (context.parsed.x / 100 * @Model.CounterOfVictory).toFixed(0) + ' (' + context.parsed.x.toFixed(1) + '%)';
                        }
                    }
                }
            }
        }
    });
</script>

