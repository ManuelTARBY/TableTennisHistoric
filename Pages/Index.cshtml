                    'rgba(253, 126, 20, 0.6)',
                    'rgba(255, 0, 0, 0.6)',
                    'rgba(147, 147, 147, 0.6)'
                ],
                borderColor: [
                    'rgba(75, 192, 192, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(253, 147, 39, 1)',
                    'rgba(255, 0, 0, 1)',
                    'rgba(130, 130, 130, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                title: {
                    display: true,
                    text: 'Répartition des résultats des matchs',
                    color: 'black'
                },
                datalabels: {
                        color: '#fff',
                        font: { weight: 'bold', size: 12 },
                    }
            }
        },
        plugins: [ChartDataLabels]
        });
