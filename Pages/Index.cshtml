</script>

<!-- Graphique en barres de la répartition des victoires par nombre de sets  -->
<script>
    const ctxVictorySets = document.getElementById('victorySetsChart');
    const victorySetLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(setLabels.Select(s => s + " sets")));

    const victorySetsChart = new Chart(ctxVictorySets, {
        type: 'bar',
        data: {
            labels: victorySetLabels,
            datasets: [
                {
                    label: 'Victoires',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(victoriesPercent)),
                    borderWidth: 1
                }
            ]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            scales: {
                x: {
                    min: 0,
                    max: 100,
                    reverse: true,
                    ticks: {
                        callback: value => value + '%',
                        color: 'black'
                    }
                },
                y: {
                    ticks: {
                        color: 'black'
                    }
                }
            },
            plugins: {
                title: {
