<!-- Graphique en barres de la distribution des résultats par classement des adversaires -->
<script>
    const ctxOpponent = document.getElementById('opponentChart');

    const opponentChart = new Chart(ctxOpponent, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(opponentLabels)),
            datasets: [{
                label: 'Proportion (%)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(victoryValues)),
                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            },
            {
                label: 'Proportion (%)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defeatValues)),
                backgroundColor: 'rgba(255, 99, 132, 0.6)',
                borderColor: 'rgba(255, 99, 132, 1)',
                borderWidth: 1
            }]
        },
        options: {
            indexAxis: 'y',
            maintainAspectRatio: false,
            responsive: true,
            scales: {
                x: {
                    stacked: true,
                    min: 0,
                    max: @(Model.VictoryDefeatMaxGauge + 2),
                    ticks: {
                        callback: value => value,
                        color: 'black'
                    }
                },
                y: {
                    stacked: true,
                    ticks: { color: 'black' }
                }
            },
            plugins: {
                legend: {
                    display: false
                },
                title: {
                    display: true,
                    text: 'Distribution des résultats par classement des adversaires',
                    color: 'black'
                },
                    tooltip: {
            callbacks: {
                title: (tooltipItems) =>{
                    return 'Classement ' + tooltipItems[0].label;
                },
                label: function (ctx) {
                    const datasets = ctx.chart.data.datasets;
                    const index = ctx.dataIndex;

                    const victory = datasets[0].data[index] || 0;
                    const defeat = datasets[1].data[index] || 0;
                    const total = victory + defeat;

                    const value = ctx.parsed.x;
                    const percentage = total > 0
                        ? ((value / total) * 100).toFixed(1)
                        : 0;

                    const label = ctx.datasetIndex === 0 ? 'victoire' : 'défaite';

                    return `${value} ${label}${value > 1 ? 's' : ''} (${percentage}%)`;
                }
            }
            }
            }
        }
    });
</script>


<!-- Modale de suppression d'un match -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer le match contre <strong id="opponentName"></strong> ?</p>
                <p class="text-muted small">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="matchId" id="modalMatchId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Supprimer définitivement</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <!-- Suppression d'un match -->
    <script>
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget; // Bouton qui a déclenché la modale
                const matchId = button.getAttribute('data-bs-matchid');
                const opponent = button.getAttribute('data-bs-opponent');

                // Mise à jour des champs de la modale
                const modalInput = deleteModal.querySelector('#modalMatchId');
                const modalOpponentText = deleteModal.querySelector('#opponentName');

                modalInput.value = matchId;
                modalOpponentText.textContent = opponent;
            });
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Ouvre la modale si ShowSeasonModal = true côté PageModel
            var showModal = @Model.ShowSeasonModal.ToString().ToLower();

            if (showModal) {
                var seasonModal = new bootstrap.Modal(document.getElementById('seasonModal'), {
                    backdrop: 'static',
                    keyboard: false
                });
                seasonModal.show();
            }

            // Bouton "Créer"
            document.getElementById("createSeasonBtn").addEventListener("click", function () {
                var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

                fetch('?handler=CreateSeasonAutomatically', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: `__RequestVerificationToken=${token}`
                })
                .then(response => {
                    if (response.ok) {
                        // La saison est créée → recharge la page
                        location.reload();
                    } else {
                        alert("Erreur lors de la création de la saison !");
                    }
                });
            });
        });
    </script>
}
