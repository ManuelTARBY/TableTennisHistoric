@page
@model TableTennisHistoric.Pages.UpdateSeasonModel
@{
    ViewData["Title"] = "Gestion des saisons";
}

<h1 class="mb-4 text-center">Gestion des saisons</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="border rounded p-4 shadow-sm bg-light mb-4">
    <h4 class="mb-3 text-primary">Créer une saison</h4>
    <form method="post" asp-page-handler="Create">

        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Début de saison</label>
                <input type="date" asp-for="CreateForm.Start_Date" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Fin de saison</label>
                <input type="date" asp-for="CreateForm.End_Date" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Fin de phase 1</label>
                <input type="date" asp-for="CreateForm.Phase1_End_Date" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Dérive phase 1</label>
                <input type="number" step="0.01" asp-for="CreateForm.p1_drift" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Dérive phase 2</label>
                <input type="number" step="0.01" asp-for="CreateForm.p2_drift" class="form-control" />
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-circle"></i> Créer
                </button>
            </div>
        </div>
    </form>
</div>
<table class="table table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>Nom</th>
            <th>Début</th>
            <th>Fin</th>
            <th>Fin phase 1</th>
            <th>Dérive phase 1</th>
            <th>Dérive phase 2</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Seasons)
        {
            <form id="update-form-@s.Id" method="post" asp-page-handler="Update">
                <input type="hidden" name="EditForm.Id" value="@s.Id" />
            </form>

            <tr>
                <!-- Nom en lecture seule -->
                <td class="fw-semibold">@s.Name</td>

                <td>
                    <input type="date"
                           name="EditForm.Start_date"
                           value="@s.Start_date.ToString("yyyy-MM-dd")"
                           form="update-form-@s.Id"
                           class="form-control form-control-sm" />
                </td>
                <td>
                    <input type="date"
                           name="EditForm.End_date"
                           value="@s.End_date.ToString("yyyy-MM-dd")"
                           form="update-form-@s.Id"
                           class="form-control form-control-sm" />
                </td>
                <td>
                    <input type="date"
                           name="EditForm.Phase1_End_date"
                           value="@s.Phase1_End_date.ToString("yyyy-MM-dd")"
                           form="update-form-@s.Id"
                           class="form-control form-control-sm" />
                </td>
                <td>
                    <input type="number"
                           name="EditForm.p1_drift"
                           value="@s.p1_drift?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                           form="update-form-@s.Id"
                           class="form-control form-control-sm text-center"
                           style="width: 90px;" step="0.01" />
                </td>
                <td>
                    <input type="number"
                           name="EditForm.p2_drift"
                           value="@s.p2_drift?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                           form="update-form-@s.Id"
                           class="form-control form-control-sm text-center"
                           style="width: 90px;" step="0.01" />
                </td>
                <td class="text-center">
                    <button type="submit"
                            form="update-form-@s.Id"
                            class="btn btn-sm btn-outline-warning"
                            title="Enregistrer">
                        <i class="bi bi-save"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>